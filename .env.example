# Copy this file to .env and fill in your values.
# The app reads these via environment variables (see choredown/settings.py).

# ---- Core ----
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# Use True only for local development. Set False on any networked/shared host.
DEBUG=True

# Comma-separated hostnames/IPs allowed to serve the app. Include your LAN IP for self-hosting.
# Example for the Proxmox VM: localhost,127.0.0.1,192.168.1.190
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.190

# ---- Database ----
DATABASE_URL=postgresql://choredown_user:your_password@localhost:5432/choredown_db

# ---- Email (optional) ----
# Leave EMAIL_BACKEND unset to print emails to the server log (console) in dev.
# For real delivery, uncomment and fill in your SMTP provider's details:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=ChoreDown <no-reply@example.com>

# ---- HTTPS hardening (only enable once the app is behind TLS) ----
# On a plain-HTTP LAN deploy, leave all of these off or the app may lock you out.
# BEHIND_TLS_PROXY=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://chores.yourdomain.com
